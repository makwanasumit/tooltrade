{
  "name": "everyday-tools-hub",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run validate:registry && npm run validate:copy && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "validate:registry": "npx tsx scripts/validate-registry.ts",
    "validate:copy": "npx tsx scripts/check-banned-words.ts",
    "postinstall": "node -e \"const fs=require('fs'),p=require('path');try{const src=require.resolve('pdfjs-dist/build/pdf.worker.min.mjs');fs.mkdirSync('public/workers',{recursive:true});fs.copyFileSync(src,'public/workers/pdf.worker.min.mjs');console.log('Copied pdf.worker.min.mjs');}catch(e){console.log('pdfjs worker skip:',e.message);}\""
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.6",
    "@gsap/react": "^2.1.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "gpt-tokenizer": "^4.1.2",
    "gsap": "^3.15.1",
    "jszip": "^3.10.2",
    "lenis": "^1.3.27",
    "lucide-react": "^1.0.0",
    "next": "^16.4.6",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.24.0",
    "eslint-config-next": "^16.4.6",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  }
}